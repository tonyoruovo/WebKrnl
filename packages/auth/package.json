{
  "name": "@webkrnl/auth",
  "version": "0.0.2",
  "description": "The Auth subsystem: sessions from app handlers, token refresh, permissions, elevations, and status in every tab of the site.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@webkrnl/core": "workspace:*"
  },
  "devDependencies": {
    "@webkrnl/core": "workspace:*",
    "@webkrnl/crypto": "workspace:*",
    "@webkrnl/network": "workspace:*",
    "@webkrnl/storage": "workspace:*",
    "@webkrnl/hub": "workspace:*",
    "@webkrnl/notification": "workspace:*",
    "@webkrnl/queue": "workspace:*"
  },
  "license": "ISC",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
