{
  "name": "@webkrnl/core",
  "version": "0.0.2",
  "description": "The kernel of the platform: units, lifecycle, dependencies, state, views, packets and scopes.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts",
    "./worker": "./src/worker.ts",
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "license": "ISC",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "import": "./dist/testing/index.js"
      },
      "./worker": {
        "types": "./dist/worker.d.ts",
        "import": "./dist/worker.js"
      },
      "./fixtures/*": "./fixtures/*"
    }
  }
}
