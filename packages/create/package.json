{
  "name": "@webkrnl/create",
  "version": "0.0.2",
  "description": "The scaffolder of WebKrnl: npm init @webkrnl writes a Vue or plain TypeScript app.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "create-webkrnl": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "templates"
  ],
  "sideEffects": false,
  "license": "ISC",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "bin": {
      "create-webkrnl": "./dist/cli.js"
    }
  }
}
