{
  "name": "@webkrnl/storage",
  "version": "0.0.2",
  "description": "The Storage subsystem: collections over IndexedDB, OPFS, Cache, Web Storage and memory, run by one coordinator for the origin.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/coordinator.worker.ts"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@webkrnl/core": "workspace:*",
    "@webkrnl/crypto": "workspace:*"
  },
  "devDependencies": {
    "@webkrnl/core": "workspace:*",
    "@webkrnl/crypto": "workspace:*",
    "@webkrnl/logger": "workspace:*",
    "@webkrnl/queue": "workspace:*",
    "zod": "^4.6.5"
  },
  "license": "ISC",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./worker": {
        "types": "./dist/coordinator.worker.d.ts",
        "import": "./dist/coordinator.worker.js"
      }
    }
  }
}
