{
  "name": "@webkrnl/realtime",
  "version": "0.0.2",
  "description": "The Realtime subsystem: one WebSocket in a dedicated worker for many topics, with reconnects, heartbeats and presence.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
