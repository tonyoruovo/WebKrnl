{
  "name": "@webkrnl/realtime",
  "version": "0.0.2",
  "description": "The Realtime subsystem: one WebSocket in a dedicated worker for many topics, with reconnects, heartbeats and presence.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/socket.worker.ts",
    "./conformance": "./src/conformance.ts"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@webkrnl/core": "workspace:*"
  },
  "devDependencies": {
    "@webkrnl/auth": "workspace:*",
    "@webkrnl/core": "workspace:*",
    "@webkrnl/global-state": "workspace:*",
    "@webkrnl/notification": "workspace:*",
    "@webkrnl/queue": "workspace:*",
    "@webkrnl/storage": "workspace:*",
    "@webkrnl/network": "workspace:*",
    "@webkrnl/hub": "workspace:*"
  },
  "license": "ISC",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./worker": {
        "types": "./dist/socket.worker.d.ts",
        "import": "./dist/socket.worker.js"
      },
      "./conformance": {
        "types": "./dist/conformance.d.ts",
        "import": "./dist/conformance.js"
      }
    }
  }
}
