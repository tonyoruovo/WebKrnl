{
  "name": "webkrnl",
  "version": "0.0.2",
  "private": true,
  "description": "A library for building web subsystems with TypeScript.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,html,css,md,yaml,yml,vue}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,html,css,md,yaml,yml,vue}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:e2e": "vitest run --project e2e",
    "test:coverage": "vitest run --project node --coverage",
    "check:browsers": "node scripts/check-browsers.ts",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:docs && pnpm check:examples && pnpm test",
    "docs:site": "typedoc",
    "check:docs": "node scripts/check-docs.ts",
    "check:examples": "node scripts/check-examples.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:docs",
    "build": "node scripts/build.ts",
    "release:check": "node scripts/release.ts check",
    "release:version": "node scripts/release.ts version"
  },
  "keywords": [
    "web",
    "subsystem",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.15.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "24.1.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "@webkrnl/analytics": "workspace:*",
    "@webkrnl/auth": "workspace:*",
    "@webkrnl/consent": "workspace:*",
    "@webkrnl/core": "workspace:*",
    "@webkrnl/crypto": "workspace:*",
    "@webkrnl/design-system": "workspace:*",
    "@webkrnl/global-state": "workspace:*",
    "@webkrnl/hub": "workspace:*",
    "@webkrnl/logger": "workspace:*",
    "@webkrnl/network": "workspace:*",
    "@webkrnl/notification": "workspace:*",
    "@webkrnl/queue": "workspace:*",
    "@webkrnl/realtime": "workspace:*",
    "@webkrnl/settings": "workspace:*",
    "@webkrnl/storage": "workspace:*",
    "@webkrnl/sync": "workspace:*",
    "@webkrnl/translation": "workspace:*",
    "browserslist": "^4.29.3",
    "eslint": "^10.7.0",
    "eslint-plugin-import-x": "^4.17.1",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.63.0",
    "prettier": "^3.9.5",
    "rolldown": "1.2.11",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.64.0",
    "vitest": "5.0.3",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  }
}
